class CameraViewModel : ViewModel() {
    private var imageCapture: ImageCapture? = null
    private val executor = Executors.newSingleThreadExecutor()

    private val _capturedPhotoUri = MutableStateFlow<Uri?>(null)
    val capturedPhotoUri: StateFlow<Uri?> = _capturedPhotoUri.asStateFlow()

    private val _isEdgeDetectionOn = MutableStateFlow(false)
    val isEdgeDetectionOn: StateFlow<Boolean> = _isEdgeDetectionOn.asStateFlow()

    private val _edgeBitmap = MutableStateFlow<Bitmap?>(null)
    val edgeBitmap: StateFlow<Bitmap?> = _edgeBitmap.asStateFlow()

    fun bindCamera(context: Context, lifecycleOwner: LifecycleOwner, previewView: PreviewView) {
        val cameraProviderFuture = ProcessCameraProvider.getInstance(context)
        cameraProviderFuture.addListener({
            val cameraProvider = cameraProviderFuture.get()

            val preview = Preview.Builder().build().also {
                it.setSurfaceProvider(previewView.surfaceProvider)
            }
            val capture = ImageCapture.Builder().build()
            imageCapture = capture

            val analysis = ImageAnalysis.Builder()
                .setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST)
                .build()
            analysis.setAnalyzer(executor) { imageProxy -> processFrame(imageProxy) }

            cameraProvider.unbindAll()
            cameraProvider.bindToLifecycle(
                lifecycleOwner, CameraSelector.DEFAULT_BACK_CAMERA, preview, capture, analysis
            )
        }, ContextCompat.getMainExecutor(context))
    }

    fun toggleEdgeDetection() {
        _isEdgeDetectionOn.value = !_isEdgeDetectionOn.value
        if (!_isEdgeDetectionOn.value) _edgeBitmap.value = null
    }

    private fun processFrame(imageProxy: ImageProxy) {
        if (!_isEdgeDetectionOn.value) {
            imageProxy.close()
            return
        }
        try {
            val gray = imageProxy.toGrayscaleMat()
            val rotated = rotateMat(gray, imageProxy.imageInfo.rotationDegrees)
            val edges = Mat()
            Imgproc.Canny(rotated, edges, 80.0, 150.0)

            val bitmap = Bitmap.createBitmap(edges.cols(), edges.rows(), Bitmap.Config.ARGB_8888)
            Utils.matToBitmap(edges, bitmap)
            _edgeBitmap.value = bitmap

            gray.release()
            if (rotated !== gray) rotated.release()
            edges.release()
        } finally {
            imageProxy.close()
        }
    }

    fun takePhoto(context: Context) {
        val capture = imageCapture ?: return

        val name = SimpleDateFormat("yyyy-MM-dd-HH-mm-ss", Locale.US)
            .format(System.currentTimeMillis())
        val contentValues = ContentValues().apply {
            put(MediaStore.MediaColumns.DISPLAY_NAME, "DropZone_$name.jpg")
            put(MediaStore.MediaColumns.MIME_TYPE, "image/jpeg")
        }

        val outputOptions = ImageCapture.OutputFileOptions.Builder(
            context.contentResolver,
            MediaStore.Images.Media.EXTERNAL_CONTENT_URI,
            contentValues
        ).build()

        capture.takePicture(
            outputOptions,
            executor,
            object : ImageCapture.OnImageSavedCallback {
                override fun onImageSaved(output: ImageCapture.OutputFileResults) {
                    _capturedPhotoUri.value = output.savedUri
                }
                override fun onError(exc: ImageCaptureException) {
                    // In a real app: surface this to the user instead of failing silently
                }
            }
        )
    }
}

private fun ImageProxy.toGrayscaleMat(): Mat {
    val yPlane = planes[0]
    val buffer = yPlane.buffer
    val rowStride = yPlane.rowStride
    val pixelStride = yPlane.pixelStride

    val data = ByteArray(buffer.remaining())
    buffer.get(data)

    val mat = Mat(height, width, CvType.CV_8UC1)
    if (pixelStride == 1 && rowStride == width) {
        mat.put(0, 0, data)
    } else {
        val rowBytes = ByteArray(width)
        for (row in 0 until height) {
            System.arraycopy(data, row * rowStride, rowBytes, 0, width)
            mat.put(row, 0, rowBytes)
        }
    }
    return mat
}

private fun rotateMat(mat: Mat, rotationDegrees: Int): Mat {
    return when (rotationDegrees) {
        90 -> Mat().also { Core.rotate(mat, it, Core.ROTATE_90_CLOCKWISE) }
        180 -> Mat().also { Core.rotate(mat, it, Core.ROTATE_180) }
        270 -> Mat().also { Core.rotate(mat, it, Core.ROTATE_90_COUNTERCLOCKWISE) }
        else -> mat
    }
}

class ArViewModel : ViewModel() {
    private val _statusMessage = MutableStateFlow("Point your phone at the floor")
    val statusMessage: StateFlow<String> = _statusMessage.asStateFlow()

    private val _isPlaced = MutableStateFlow(false)
    val isPlaced: StateFlow<Boolean> = _isPlaced.asStateFlow()

    fun onTrackingUpdate(trackingState: TrackingState, floorVisible: Boolean) {
        if (_isPlaced.value) return
        _statusMessage.value = when {
            trackingState != TrackingState.TRACKING -> "Move your phone slowly to start tracking"
            !floorVisible -> "Point your phone at the floor to detect it"
            else -> "Floor detected — tap the floor to place the package"
        }
    }

    fun onAnchorPlaced(anchor: Anchor) {
        _isPlaced.value = true
        _statusMessage.value = "Package placed"
    }

    fun onNoFloorHit() {
        _statusMessage.value = "That tap wasn't on the detected floor — try again"
    }

    fun reset() {
        _isPlaced.value = false
        _statusMessage.value = "Point your phone at the floor"
    }
}

