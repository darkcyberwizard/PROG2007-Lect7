@Composable
fun DropZoneApp(viewModel: CameraViewModel = viewModel()) {
    val navController = rememberNavController()

    NavHost(navController = navController, startDestination = Start) {
        composable<Start> {
            StartScreen(onStart = { navController.navigate(Camera) })
        }
        composable<Camera> {
            CameraScreen(
                viewModel = viewModel,
                onMarkDeliverySpot = { navController.navigate(Ar) }
            )
        }
        composable<Ar> {
            ArScreen()
        }
    }
}

@Composable
fun StartScreen(onStart: () -> Unit) {
    Box(
        modifier = Modifier.fillMaxSize(),
        contentAlignment = Alignment.Center
    ) {
        Column(
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.spacedBy(16.dp)
        ) {
            Text(
                text = "DropZone",
                style = MaterialTheme.typography.headlineLarge,
                fontWeight = FontWeight.Bold
            )
            Text(
                text = "Proof-of-delivery photos, powered by camera and AR",
                style = MaterialTheme.typography.bodyMedium
            )
            Button(onClick = onStart) {
                Text("Start")
            }
        }
    }
}

@Composable
fun CameraScreen(
    viewModel: CameraViewModel = viewModel(),
    onMarkDeliverySpot: () -> Unit = {}
) {
    val context = LocalContext.current
    val lifecycleOwner = LocalLifecycleOwner.current
    val capturedPhotoUri by viewModel.capturedPhotoUri.collectAsState()
    val isEdgeDetectionOn by viewModel.isEdgeDetectionOn.collectAsState()
    val edgeBitmap by viewModel.edgeBitmap.collectAsState()
    var hasCameraPerm by remember { mutableStateOf(hasCameraPermission(context)) }

    val permissionLauncher = rememberLauncherForActivityResult(
        ActivityResultContracts.RequestPermission()
    ) { granted -> hasCameraPerm = granted }

    Box(modifier = Modifier.fillMaxSize()) {
        if (hasCameraPerm) {
            AndroidView(
                factory = { ctx ->
                    PreviewView(ctx).also { previewView ->
                        viewModel.bindCamera(ctx, lifecycleOwner, previewView)
                    }
                },
                modifier = Modifier.fillMaxSize()
            )

            if (isEdgeDetectionOn && edgeBitmap != null) {
                Image(
                    bitmap = edgeBitmap!!.asImageBitmap(),
                    contentDescription = "Live edge detection overlay",
                    modifier = Modifier.fillMaxSize()
                )
            }

            Column(
                modifier = Modifier
                    .align(Alignment.Center)
                    .padding(24.dp),
                horizontalAlignment = Alignment.CenterHorizontally,
                verticalArrangement = Arrangement.spacedBy(16.dp)
            ) {
                Button(onClick = { viewModel.takePhoto(context) }) {
                    Text("Take Proof-of-Delivery Photo")
                }
                Button(onClick = { viewModel.toggleEdgeDetection() }) {
                    Text(if (isEdgeDetectionOn) "Hide Edge Detection" else "Show Edge Detection")
                }
                if (capturedPhotoUri != null) {
                    Text(
                        text = "Saved: $capturedPhotoUri",
                        color = Color.White,
                        modifier = Modifier
                            .background(Color.Black, shape = RoundedCornerShape(8.dp))
                            .padding(horizontal = 12.dp, vertical = 6.dp)
                    )
                    Button(onClick = onMarkDeliverySpot) {
                        Text("Mark Delivery Spot")
                    }
                }
            }
        } else {
            Column(
                modifier = Modifier
                    .align(Alignment.Center)
                    .padding(24.dp),
                horizontalAlignment = Alignment.CenterHorizontally,
                verticalArrangement = Arrangement.spacedBy(16.dp)
            ) {
                Text("Camera permission is needed to take a delivery photo.")
                Button(onClick = { permissionLauncher.launch(Manifest.permission.CAMERA) }) {
                    Text("Grant Camera Permission")
                }
            }
        }
    }
}

@Composable
fun ArScreen(arViewModel: ArViewModel = viewModel()) {
    val context = LocalContext.current
    val lifecycleOwner = LocalLifecycleOwner.current
    val statusMessage by arViewModel.statusMessage.collectAsState()
    val isPlaced by arViewModel.isPlaced.collectAsState()

    val sessionHolder = remember { mutableStateOf<Session?>(null) }
    val renderer = remember {
        ArRenderer(
            onAnchorPlaced = { anchor -> arViewModel.onAnchorPlaced(anchor) },
            onNoFloorHit = { arViewModel.onNoFloorHit() },
            onTrackingUpdate = { state, floorVisible -> arViewModel.onTrackingUpdate(state, floorVisible) }
        )
    }

    DisposableEffect(lifecycleOwner) {
        val observer = LifecycleEventObserver { _, event ->
            when (event) {
                Lifecycle.Event.ON_RESUME -> {
                    if (sessionHolder.value == null && hasCameraPermission(context)) {
                        try {
                            val newSession = Session(context)
                            val config = Config(newSession).apply {
                                planeFindingMode = Config.PlaneFindingMode.HORIZONTAL
                            }
                            newSession.configure(config)
                            sessionHolder.value = newSession
                            renderer.session = newSession
                        } catch (e: UnavailableException) {
                            Log.e("ArScreen", "Failed to create AR session", e)
                        }
                    }
                    sessionHolder.value?.resume()
                }
                Lifecycle.Event.ON_PAUSE -> {
                    sessionHolder.value?.pause()
                }
                else -> {}
            }
        }
        lifecycleOwner.lifecycle.addObserver(observer)
        onDispose {
            lifecycleOwner.lifecycle.removeObserver(observer)
            sessionHolder.value?.close()
        }
    }

    Box(modifier = Modifier.fillMaxSize()) {
        AndroidView(
            factory = { ctx ->
                GLSurfaceView(ctx).apply {
                    setEGLContextClientVersion(2)
                    setEGLConfigChooser(8, 8, 8, 8, 16, 0)
                    setRenderer(renderer)
                    renderMode = GLSurfaceView.RENDERMODE_CONTINUOUSLY
                    setOnTouchListener { _, event ->
                        if (event.action == MotionEvent.ACTION_UP) renderer.onTap(event)
                        true
                    }
                }
            },
            modifier = Modifier.fillMaxSize()
        )

        Column(
            modifier = Modifier
                .align(Alignment.BottomCenter)
                .padding(24.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.spacedBy(12.dp)
        ) {
            Text(
                text = statusMessage,
                color = Color.White,
                modifier = Modifier
                    .background(Color.Black, shape = RoundedCornerShape(8.dp))
                    .padding(horizontal = 12.dp, vertical = 6.dp)
            )
            if (isPlaced) {
                Button(onClick = {
                    renderer.clearAnchor()
                    arViewModel.reset()
                }) {
                    Text("Place Again")
                }
            }
        }
    }
}
